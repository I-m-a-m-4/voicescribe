rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile access
    match /users/{userId} {
      // Allow read for user profile lookups & admin analytics
      allow read: if true;
      // Allow user updates and desktop profile sync
      allow write: if true;
      
      // User transcriptions history subcollection
      match /transcriptions/{transcriptionId} {
        allow read, write, delete: if true;
      }
    }

    // Temporary desktop authorization handshake sessions
    match /desktop_auth/{sessionId} {
      allow get, create, update, delete: if true;
      allow list: if false;
    }

    match /desktop_auth_codes/{code} {
      allow get, create, update, delete: if true;
      allow list: if false;
    }

    // Unique visitors and retention cohorts analytics
    match /visitors/{visitorId} {
      allow read, write: if true;
    }

    match /platform_analytics/{docId} {
      allow read, write: if true;
    }
  }
}
