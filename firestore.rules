rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile access
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow admin to read all profiles for platform analytics
      allow read: if request.auth != null && request.auth.token.email == "belloimam431@gmail.com";
      
      // User transcriptions history subcollection
      match /transcriptions/{transcriptionId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Temporary desktop authorization handshake sessions
    match /desktop_auth/{sessionId} {
      allow get, create, update, delete: if true;
      allow list: if false;
    }

    match /desktop_auth_codes/{code} {
      allow get, create, update, delete: if true;
      allow list: if false;
    }
  }
}
