{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VoiceScribe",
  "version": "0.1.0",
  "identifier": "com.voicescribe.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3005",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "VoiceScribe - AI Audio & Video Transcription",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "VoiceScribe",
    "copyright": "Copyright © 2026 VoiceScribe",
    "category": "Productivity",
    "shortDescription": "VoiceScribe AI Audio and Video Transcription Application",
    "longDescription": "VoiceScribe provides powerful, privacy-first AI audio and video transcription directly on your device.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
